# Copy this file to .env (git-ignored) and fill in your own values.
# The backend reads .env from the repository root or from bioMedical/, and VS Code's launch config loads it too.

# Gmail account used to send confirmation and reset e-mails (use a Google "app password", not your login password)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# MySQL database
DB_URL=jdbc:mysql://localhost:3306/userauth
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Secret for signing login tokens. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-base64-string

# Optional
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# JWT_EXPIRATION=86400000
# PORT=8080
